{
  "schemaVersion": 1,
  "id": "darthbeltazarskit",
  "version": "${version}",
  "name": "DarthBeltazar's kit",
  "description": "A Meteor Client addon",
  "authors": [
    "DarthBeltazar"
  ],
  "contact": {
    "sources": "https://github.com/DarthBeltazar/DBK"
  },
  "icon": "assets/dbk/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.darthbeltazar.dbk.Addon"
    ]
  },
  "mixins": [
    "mixins.dbk.json"
  ],
  "custom": {
    "meteor-client:color": "0,25,255"
  },
  "depends": {
    "java": ">=21",
    "minecraft": [
      "${mc_version}"
    ],
    "meteor-client": "*"
  }
}
